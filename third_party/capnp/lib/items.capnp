  useVecIcon @7 :Bool;
  spec @8 :Text;
}

struct Items {
  tempTipVisible @0 :Bool;
  spec_ip_addr_prefixes @1 :List(Text);
  ipv6Guard @2 :Bool;
  shutdownSomeArea @3 :Bool;
  useBlurWallpaper @4 :Bool;
  itemList @5 :List(Item);
}