@0xdd1d0540a126f16d;  # unique file ID, generated by `capnp id`

struct Item {
  emojiIcon @0 :Text;
  imgUrl @1 :Text;
  zhImgUrl @2 :Text;
  title @3 :Text;
  zhTitle @4 :Text;
  enUrl @5 :Text;
