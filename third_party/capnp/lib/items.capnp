@0xdd1d0540a126f16d;  # unique file ID, generated by `capnp id`

struct Item {
  emojiIcon @0 :Text;
  imgUrl @1 :Text;
  zhImgUrl @2 :Text;
  title @3 :Text;
  zhTitle @4 :Text;
  enUrl @5 :Text;
  zhUrl @6 :Text;
}

struct Items {
  tempTipVisible @0 :Bool;
  specIpAddrPrefix @1 :Text;
  ipv6Guard @2 :Bool;
  shutdownSomeArea @3 :Bool;
  useBlurWallpaper @4 :Bool;
  itemList @5 :List(Item);
}